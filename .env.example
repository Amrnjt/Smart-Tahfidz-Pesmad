# Firebase client configuration used by Vercel Preview/test builds.
# All VITE_* values below must point to an isolated Firebase test project when VERCEL_ENV=preview.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# Firebase Admin / Custom Auth (server-only; never expose these as VITE_* variables)
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIREBASE_CLIENT_EMAIL=
# Store the PEM private key as one environment value. Escaped \n is supported.
FIREBASE_PRIVATE_KEY=

# One-time P0.1 credential migration guard. Use a long random secret (24+ characters).
P0_MIGRATION_SECRET=
# Keep false after the controlled migration endpoint has succeeded.
P0_ALLOW_LEGACY_LOGIN_MIGRATION=false

# Gemini API (if server-side AI features are enabled)
GEMINI_API_KEY=
