# Firebase client configuration
FIREBASE_API_KEY=

# Firebase Admin / Custom Auth (server-only; never expose as VITE_* variables)
FIREBASE_PROJECT_ID=tonal-garage-pn96h
FIRESTORE_DATABASE_ID=ai-studio-pesmadsmarttahfi-4e6782fc-20ad-4a80-8224-2ddf36e8d09e
FIREBASE_CLIENT_EMAIL=
# Store the PEM private key as one environment value. Escaped \n is supported.
FIREBASE_PRIVATE_KEY=

# One-time P0.1 credential migration guard. Use a long random secret (24+ characters).
P0_MIGRATION_SECRET=
# Keep false in production after the controlled migration endpoint has succeeded.
P0_ALLOW_LEGACY_LOGIN_MIGRATION=false

# Gemini API (if server-side AI features are enabled)
GEMINI_API_KEY=
