rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasAuthProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/auth_profiles/$(request.auth.uid));
    }

    function role() {
      return get(/databases/$(database)/documents/auth_profiles/$(request.auth.uid)).data.role;
    }

    function isSuperadmin() {
      return hasAuthProfile() && role() == 'Superadmin';
    }

    function isUstadz() {
      return hasAuthProfile() && role() == 'Ustadz';
    }

    function isPimpinan() {
      return hasAuthProfile() && role() == 'Pimpinan';
    }

    function isKnownReadRole() {
      return hasAuthProfile()
        && role() in ['Superadmin', 'Ustadz', 'Pimpinan', 'Wali', 'Santri'];
    }

    function canWriteTahfidz() {
      return isSuperadmin() || isUstadz();
    }

    // This file is the authenticated vNext ruleset. It is intentionally NOT
    // the currently deployed firestore.rules until Firebase Auth migration is complete.
    // Pimpinan is included in read access but never in mutation helpers.

    match /auth_profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperadmin());
      allow write: if isSuperadmin();
    }

    match /users/{userId} {
      allow read: if isKnownReadRole();
      allow write: if isSuperadmin();
    }

    match /santri/{santriId} {
      allow read: if isKnownReadRole();
      allow write: if canWriteTahfidz();
    }

    match /ziyadah/{ziyadahId} {
      allow read: if isKnownReadRole();
      allow write: if canWriteTahfidz();
    }

    match /murojaah/{murojaahId} {
      allow read: if isKnownReadRole();
      allow write: if canWriteTahfidz();
    }

    match /binnadzor/{binnadzorId} {
      allow read: if isKnownReadRole();
      allow write: if canWriteTahfidz();
    }

    match /pembelajaran/{pembelajaranId} {
      allow read: if isKnownReadRole();
      allow write: if canWriteTahfidz();
    }

    match /kelas/{kelasId} {
      allow read: if isKnownReadRole();
      allow write: if canWriteTahfidz();
    }

    match /pantauan_liburan/{id} {
      allow read: if isKnownReadRole();
      allow write: if canWriteTahfidz();
    }

    match /app_config/{id} {
      allow read: if isKnownReadRole();
      allow write: if canWriteTahfidz();
    }

    match /trash_records/{trashId} {
      allow read: if canWriteTahfidz();
      allow write: if canWriteTahfidz();
    }
  }
}
