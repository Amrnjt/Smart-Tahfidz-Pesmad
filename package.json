{
  "name": "pesmad-smart-tahfidz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "node scripts/verify-preview-environment.mjs && node -e \"console.log('=== BUILD LOG START [' + new Date().toISOString() + '] ==='); console.log('Builder Environment Check Passed.');\"",
    "build": "vite build",
    "postbuild": "node -e \"console.log('=== BUILD LOG END: Build successful! ===');\"",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:auth-runtime": "firebase emulators:exec --project demo-smart-tahfidz --only auth,firestore \"tsx --test tests/auth.runtime.test.ts\"",
    "test:firestore-rules": "firebase emulators:exec --project demo-smart-tahfidz --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "verify:security-bootstrap": "node scripts/verify-security-bootstrap.mjs",
    "verify:cutover-env": "node scripts/verify-security-bootstrap.mjs --require-env",
    "verify:preview-env": "node scripts/verify-preview-environment.mjs"
  },
  "npm": {
    "allow-scripts": {
      "$3": true,
      "esbuild": true,
      "@tailwindcss/vite": true
    }
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase": "^12.18.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "firebase-admin": "^14.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.29.0"
  },
  "engines": {
    "node": "22.x"
  }
}
