rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /santri/{santriId} {
      allow read, write: if true;
    }
    match /ziyadah/{ziyadahId} {
      allow read, write: if true;
    }
    match /murojaah/{murojaahId} {
      allow read, write: if true;
    }
    match /binnadzor/{binnadzorId} {
      allow read, write: if true;
    }
  }
}
