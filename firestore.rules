rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function account() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
  function signedIn() { return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
  function staff() { return signedIn() && account().role in ['Ustadz', 'Admin', 'Superadmin']; }
  function admin() { return signedIn() && account().role in ['Admin', 'Superadmin']; }
  function protectedId(id) { return exists(/databases/$(database)/documents/security/superadmin) && get(/databases/$(database)/documents/security/superadmin).data.userId == id; }
  function ownsSantri(id) { return signedIn() && account().role == 'Wali' && account().idSantri == id; }
  match /security/{id} { allow read: if signedIn(); allow write: if false; }
  match /users/{userId} {
   allow update: if signedIn() && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notificationPermission']) && request.resource.data.notificationPermission in ['default', 'granted', 'denied'];
   allow read: if staff() || (signedIn() && request.auth.uid == userId);
   allow create: if staff() && request.resource.data.username is string && request.resource.data.username.lower() != 'anas' && !protectedId(userId) && request.resource.data.id == userId && request.resource.data.role in ['Ustadz', 'Admin', 'Wali', 'Santri'] && (request.resource.data.role != 'Admin' || admin());
   allow update: if staff() && request.resource.data.username is string && request.resource.data.username.lower() != 'anas' && !protectedId(userId) && resource.data.role != 'Superadmin' && request.resource.data.id == userId && request.resource.data.role in ['Ustadz', 'Admin', 'Wali', 'Santri'] && (request.resource.data.role == resource.data.role || request.resource.data.role != 'Admin' || admin());
   allow delete: if staff() && !protectedId(userId) && resource.data.role != 'Superadmin';
  }
  match /pantauan_config/{configId} {
   allow read: if signedIn();
   allow create, update: if admin() && configId == 'pantauan-config-001' && request.resource.data.keys().hasOnly(['id', 'isEnabled', 'lastUpdated', 'updatedBy']) && request.resource.data.id == configId && request.resource.data.isEnabled is bool && request.resource.data.lastUpdated is string && request.resource.data.updatedBy == request.auth.uid;
   allow delete: if false;
  }
  match /wirid_yaumiyyah/{recordId} {
   function validPrayer(value) { return value in ["Jama'ah", 'Berhalangan', 'Sakit']; }
   function validRecord() {
    let d = request.resource.data;
    return d.keys().hasAll(['id', 'timestamp', 'idSantri', 'inputBy', 'alWaqiah', 'alMulk', 'alInsyirah', 'shubuh', 'dzuhur', 'ashar', 'maghrib', 'isya']) && d.keys().hasOnly(['id', 'timestamp', 'idSantri', 'namaSantri', 'inputBy', 'alWaqiah', 'alMulk', 'alInsyirah', 'shubuh', 'dzuhur', 'ashar', 'maghrib', 'isya']) && d.id == recordId && d.inputBy == request.auth.uid && d.timestamp is string && d.timestamp.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2} 12:00$') && d.alWaqiah is bool && d.alMulk is bool && d.alInsyirah is bool && validPrayer(d.shubuh) && validPrayer(d.dzuhur) && validPrayer(d.ashar) && validPrayer(d.maghrib) && validPrayer(d.isya);
   }
   allow read: if staff() || ownsSantri(resource.data.idSantri);
   allow create: if ownsSantri(request.resource.data.idSantri) && validRecord() && get(/databases/$(database)/documents/pantauan_config/pantauan-config-001).data.isEnabled == true;
   allow update: if ownsSantri(resource.data.idSantri) && request.resource.data.idSantri == resource.data.idSantri && validRecord() && get(/databases/$(database)/documents/pantauan_config/pantauan-config-001).data.isEnabled == true;
   allow delete: if false;
  }
  // Existing teaching collections are outside this account/program change.
  match /santri/{id} { allow read, write: if true; }
  match /ziyadah/{id} { allow read, write: if true; }
  match /murojaah/{id} { allow read, write: if true; }
  match /binnadzor/{id} { allow read, write: if true; }
  match /kelas/{id} { allow read, write: if true; }
  match /pembelajaran/{id} { allow read, write: if true; }
 }
}
